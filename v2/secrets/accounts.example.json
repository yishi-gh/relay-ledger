{
  "version": 3,
  "currency": "USD",
  "quota_per_unit": 500000,
  "upstream": {
    "timeout_ms": 20000,
    "min_interval_ms": 1200,
    "retry_delay_ms": 500,
    "job_stale_ms": 1800000,
    "refresh_threshold_ms": 7200000
  },
  "accounts": [
    {
      "id": "upstream-a",
      "name": "Example Upstream A",
      "kind": "newapi",
      "base_url": "https://upstream-a.example.com",
      "unit": "USD",
      "enabled": true,
      "channels": [13, 14],
      "auth": {
        "mode": "bearer",
        "token": "nap_EXAMPLE_LONG_LIVED_PAT",
        "cookie": "",
        "refresh_token": "",
        "expires_at": null,
        "user_id": 10001,
        "token_env": "RELAY_UPSTREAM_A_TOKEN",
        "header": "Authorization",
        "scheme": "Bearer",
        "headers": {}
      },
      "endpoints": {
        "balance": "/api/user/self",
        "credits": "/api/log/self",
        "usage": "/api/log/self/stat"
      },
      "balance_field": "quota",
      "quota_per_unit": 500000
    },
    {
      "id": "upstream-b",
      "name": "Example Upstream B",
      "kind": "newapi",
      "base_url": "https://upstream-b.example.com",
      "unit": "USD",
      "enabled": true,
      "channels": [27],
      "auth": {
        "mode": "cookie",
        "token": "",
        "cookie": "session=EXAMPLE_SESSION; refresh=EXAMPLE_REFRESH",
        "refresh_token": "",
        "expires_at": null,
        "user_id": 10002,
        "session": "EXAMPLE_AUTH_SESSION",
        "refresh_path": "/api/user/auth/refresh",
        "token_env": "",
        "header": "Authorization",
        "scheme": "Bearer",
        "headers": {}
      },
      "endpoints": {
        "balance": "/api/user/self",
        "credits": "/api/log/self",
        "usage": "/api/log/self/stat"
      },
      "balance_field": "quota",
      "quota_per_unit": 500000
    },
    {
      "id": "upstream-c",
      "name": "Example Upstream C",
      "kind": "sub2api",
      "base_url": "https://upstream-c.example.com",
      "unit": "USD",
      "enabled": true,
      "channels": [21],
      "auth": {
        "mode": "bearer",
        "token": "ACCESS_TOKEN",
        "cookie": "",
        "refresh_token": "REFRESH_TOKEN",
        "expires_at": 1760000000000,
        "user_id": 10003,
        "token_env": "",
        "header": "Authorization",
        "scheme": "Bearer",
        "headers": {}
      },
      "endpoints": {
        "balance": "/api/v1/auth/me",
        "usage": "/api/v1/usage/stats?period=today"
      },
      "balance_field": "balanceUsd",
      "quota_per_unit": null
    },
    {
      "id": "subscription-lines",
      "name": "Example Subscription Lines",
